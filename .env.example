# Copy this file to .env.local and fill in the values.
# Also add the same variables in your hosting provider's environment settings.

# Web3Forms access key for the Contact Us form (https://web3forms.com).
# Public by design: it ships in the page and only routes submissions to the team inbox.
NEXT_PUBLIC_WEB3FORMS_ACCESS_KEY=

# Public site address (no trailing slash), used for canonical URLs, sitemap, robots.txt and link previews.
# e.g. https://pawse.app. On Vercel it falls back to the production URL if unset.
NEXT_PUBLIC_SITE_URL=
